# Runtime configuration for the container. In development, edit
# public/config.js instead; Vite serves it as-is.
#
# The API's public URL, no trailing slash. The API must list this app's
# origin in its API_CORS_ORIGINS.
API_URL=http://localhost:8000

# The Streamlit dashboard, linked from views not yet ported. Empty hides the
# link. Remove once all four views are ported.
DASHBOARD_URL=http://localhost:8501
