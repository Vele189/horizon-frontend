server {
    listen       ${PORT};
    listen       [::]:${PORT};
    server_name  _;
    root         /usr/share/nginx/html;

    # Railway's healthcheck. Answers without touching the app or the API.
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Written at start-up from the environment; never cache it, or a changed
    # API_URL would not reach a returning visitor.
    location = /config.js {
        add_header Cache-Control "no-store";
    }

    # Content-hashed by Vite, so safe to cache for a year.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # Client-side routes: every unknown path is the app.
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri /index.html;
    }

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
}
