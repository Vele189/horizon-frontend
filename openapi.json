  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "description": "Liveness. Never touches the database, so a sleeping Neon cannot fail it.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health",
        "tags": [
          "operations"
        ]
      }
    },
    "/ready": {
      "get": {
        "description": "Readiness: one uncached round trip to the serving warehouse.",
        "operationId": "ready_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Ready"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Ready",
        "tags": [
          "operations"
        ]
      }
    },
    "/v1/anomalies": {
      "get": {
        "description": "Every city on one day, with its departure and, where fitted, its rarity.",
        "operationId": "anomalies_v1_anomalies_get",
        "parameters": [
          {
            "description": "Defaults to the last scored day.",
            "in": "query",
            "name": "day",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date",
                  "type": "string"
                },
                {
                  "type": "null"
                }
